{
    "name": "fastify-auth",
    "version": "1.0.0",
    "description": "",
    "main": "index.js",
    "type": "module",
    "scripts": {
        "dev": "nodemon",
        "start": "node dist/index.js",
        "build": "tsc && tsup",
        "check:types": "tsc --noEmit",
        "test": "echo \"Error: no test specified\" && exit 1",
        "migration:create": "tsx src/scripts/create-migration.ts",
        "db:migrate": "tsx src/scripts/migrate.ts",
        "db:rollback": "tsx src/scripts/migrate.ts down",
        "db:step": "tsx src/scripts/migrate.ts up",
        "generate:types": "kysely-codegen --out-file ./src/types/db.d.ts"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@fastify/autoload": "^6.5.0",
        "@fastify/cookie": "^11.1.2",
        "@fastify/cors": "^10.1.0",
        "@fastify/helmet": "^13.1.1",
        "@fastify/jwt": "^10.2.2",
        "@fastify/multipart": "^9.4.0",
        "@fastify/rate-limit": "^10.3.0",
        "@fastify/swagger": "^9.9.1",
        "@fastify/swagger-ui": "^6.1.1",
        "@fastify/type-provider-zod": "^1.0.0",
        "argon2": "^0.45.1",
        "cloudinary": "^2.11.0",
        "date-fns": "^4.4.0",
        "dotenv": "^16.6.1",
        "fastify": "^5.12.5",
        "fastify-plugin": "^6.0.0",
        "http-status-codes": "^2.3.0",
        "kysely": "^0.29.6",
        "nanoid": "^6.0.1",
        "node-cron": "^3.0.3",
        "nodemailer": "^6.10.1",
        "pg": "^8.23.1",
        "pino": "^9.14.0",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@types/node": "^26.6.3",
        "@types/pg": "^8.23.1",
        "@vitest/coverage-v8": "^5.0.3",
        "kysely-codegen": "^0.20.0",
        "nodemon": "^3.1.14",
        "pino-pretty": "^13.1.3",
        "tsup": "^8.5.1",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2",
        "vitest": "^5.0.3"
    },
    "tsup": {
        "entry": [
            "src/index.ts"
        ],
        "outDir": "dist",
        "format": [
            "esm",
            "cjs"
        ],
        "target": "es2020",
        "sourcemap": true,
        "clean": true,
        "dts": false,
        "splitting": false,
        "skipNodeModulesBundle": true
    }
}
